rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile rules (Participant basic registration & gift boxes wishlist)
    match /users/{userId} {
      allow get, list: if true;
      
      allow create: if (
        incoming().name is string && incoming().name.size() <= 100 &&
        incoming().password is string && incoming().password.size() <= 50
      );
      
      allow update: if (
        incoming().diff(existing()).affectedKeys().hasOnly(['giftBoxes', 'name', 'password', 'updatedAt'])
      );

      allow delete: if true;
    }

    // Room rules
    match /rooms/{roomId} {
      // Allow reading, listing, creating, updating and deleting rooms
      allow get, list, create, update, delete: if true;
    }

    // Participant rules
    match /rooms/{roomId}/participants/{participantId} {
      // Everyone in the room can list, view, create, update and delete participants
      allow get, list, create, update, delete: if true;
    }

    // Result rules
    match /rooms/{roomId}/results/{participantId} {
      // Allow reading, listing (for reset cleanup), creating, updating, and deleting
      allow get, list, create, update, delete: if true;
    }
  }
}
